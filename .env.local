# Port the Express server listens on
PORT=4000

# Comma-separated list of allowed CORS origins (the frontend's URL(s))
FRONTEND_ORIGIN="http://localhost:3000,http://localhost:3001"

# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mangal_superfoods"

# WhatsApp-based OTP delivery via whapi.cloud
WHAPI_BASE_URL="https://gate.whapi.cloud"
WHAPI_TOKEN=""

# S3-compatible object storage for product images
BUCKET_NAME="mangal-superfoods"
S3_ENDPOINT="http://localhost:4566"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"
AWS_ACCESS_KEY="test"

# Node environment
NODE_ENV="development"
