{
  "name": "mangal-superfoods-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.js",
    "dev:debug": "bun --inspect=localhost:6499/mangal --watch server.js",
    "start": "bun server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "reset-db": "prisma migrate reset --force && prisma db seed",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "prisma:db:pull": "prisma db pull",
    "prisma:db:seed": "prisma db seed",
    "prisma:format": "prisma format",
    "postinstall": "prisma generate",
    "init:s3": "chmod +x init-s3.sh && ./init-s3.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1018.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "prisma": "^7.6.0"
  }
}
